							"referenceName": "LS_lookup",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"TableName": {
						"type": "string"
					},
					"TableSchema": {
						"type": "string"
					},
					"WatermarkColumn": {
						"type": "string"
					}
				},
				"variables": {
					"TableName": {
						"type": "String"
					},
					"TableSchema": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-07-19T20:03:56Z"
			},
