		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "migration11adf"
		},
		"LS_SQLTABLE_PARQUET_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SQLTABLE_PARQUET'"
		},
		"LS_SqlServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SqlServer1'"
		},
		"LS_lookup_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_lookup'"
		},
		"LS_SQLTABLE_PARQUET_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://mirgation11.dfs.core.windows.net/"
		},
		"LS_SqlServer1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "LAPTOP-VUVAV5I4\\SQLEXPRESS"
		},
		"LS_SqlServer1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "RetailDW_Dev"
		},
		"LS_SqlServer1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Nitin0001"
		},
		"LS_lookup_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"LS_lookup_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Retail_DB"
		},
		"LS_lookup_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Nitin0001"
		}
